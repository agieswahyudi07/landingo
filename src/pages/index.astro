---
import Layout from '../layouts/Layout.astro';
import Header from '../components/section/Header.astro';
import Hero from '../components/section/Hero.astro';
import Process from '../components/section/Process.astro';
import ValueProposition from '../components/section/ValueProposition.astro';
import Footer from '../components/section/Footer.astro';
import DesignShowcase from '../components/section/DesignShowcase.vue';
import Pricing from '../components/section/Pricing.astro';
import Faq from '../components/section/Faq.astro';
import Cta from '../components/section/Cta.astro';
import MobileCta from '../components/section/MobileCta.astro';
---

<Layout
  title="Landingo — Jasa Landing Page UMKM Profesional | Mulai Rp 1,5 Jt"
  description="Jasa landing page UMKM cepat, SEO & GEO ready, dan terintegrasi WhatsApp plus tracking iklan. Terima beres mulai Rp 1,5 Juta, online dalam 2–5 hari kerja."
  includeHomeFaqSchema={true}
>
  <Header />
  <main id="main-content">
    <Hero />
    <Process />
    <DesignShowcase client:visible />
    <ValueProposition />
    <Pricing />
    <Faq />
    <Cta />
  </main>
  <Footer />
  <MobileCta />
</Layout>
