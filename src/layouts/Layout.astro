---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../assets/main.css';
import { homeFaqs } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  includeHomeFaqSchema?: boolean;
}

const {
  title = 'Landingo — Jasa Landing Page UMKM Profesional | Mulai Rp 1,5 Jt',
  description = 'Jasa landing page UMKM cepat, SEO & GEO ready, dan terintegrasi WhatsApp plus tracking iklan. Terima beres mulai Rp 1,5 Juta, online dalam 2–5 hari kerja.',
  image = 'https://landingo.id/assets/images/seo.webp',
  type = 'website',
  noindex = false,
  includeHomeFaqSchema = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://landingo.id');
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const graphNodes: Record<string, unknown>[] = [
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': 'https://landingo.id/#organization',
    name: 'Landingo',
    url: 'https://landingo.id',
    logo: 'https://landingo.id/assets/images/landingo_logo.webp',
    image: 'https://landingo.id/assets/images/seo.webp',
    description:
      'Jasa pembuatan landing page terima beres dan profesional untuk bisnis jasa & UMKM di Indonesia. Mobile-first, loading cepat, SEO & GEO ready, dan terintegrasi WhatsApp.',
    priceRange: 'IDR 1.500.000 - IDR 8.500.000',
    currenciesAccepted: 'IDR',
    paymentAccepted: 'Bank Transfer',
    areaServed: {
      '@type': 'Country',
      name: 'Indonesia',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+62-851-8307-7289',
      contactType: 'customer service',
      availableLanguage: ['Indonesian', 'English'],
    },
    sameAs: [
      'https://www.instagram.com/landingo.id',
      'https://www.facebook.com/landingo.id',
      'https://www.linkedin.com/company/landingo.id',
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Paket Pembuatan Landing Page Landingo',
      itemListElement: [
        {
          '@type': 'Offer',
          name: 'LANDINGO LITE',
          description:
            '1 halaman landing page konversi tinggi untuk bisnis jasa, tombol WhatsApp langsung, domain & hosting 1 tahun, pengerjaan 2-3 hari kerja.',
          price: '1500000',
          priceCurrency: 'IDR',
          url: 'https://landingo.id/#pricing',
          itemOffered: {
            '@type': 'Service',
            name: 'Jasa Landing Page Paket LITE',
          },
        },
        {
          '@type': 'Offer',
          name: 'LANDINGO PRO',
          description:
            'Hingga 5 halaman website terpisah, Form Interaktif Dual-Action rekap otomatis ke Google Sheet klien & WhatsApp, Gratis Full Ads Tracking Setup (Meta Pixel + GTM + GA4), 1 akun email bisnis resmi.',
          price: '4500000',
          priceCurrency: 'IDR',
          url: 'https://landingo.id/#pricing',
          itemOffered: {
            '@type': 'Service',
            name: 'Jasa Landing Page Paket PRO (Paling Laris)',
          },
        },
        {
          '@type': 'Offer',
          name: 'LANDINGO FUNNEL',
          description:
            'Hingga 10 halaman website eksklusif, Akses Akun Landingo Central CMS Dashboard (kelola katalog & database leads mandiri), 3 akun email bisnis resmi, Gratis Full Ads Tracking.',
          price: '8500000',
          priceCurrency: 'IDR',
          url: 'https://landingo.id/#pricing',
          itemOffered: {
            '@type': 'Service',
            name: 'Jasa Landing Page Paket FUNNEL (Eksklusif CMS)',
          },
        },
      ],
    },
  },
];

if (includeHomeFaqSchema) {
  graphNodes.push({
    '@type': 'FAQPage',
    '@id': 'https://landingo.id/#faq',
    mainEntity: homeFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="landing page profesional, website UMKM, landing page murah, landing page SEO GEO optimized, jasa pembuatan landing page, landing page Indonesia, website untuk bisnis, landing page cepat, landing page mobile-first, landing page WhatsApp ready" />
    <meta name="author" content="Landingo" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:site_name" content="Landingo" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Icons & Canonical -->
    <link rel="icon" type="image/svg+xml" href="/assets/images/landingo_logo2.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL.toString()} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#5356FF" />

    <!-- LLM Context & AI Agent Discovery -->
    <link rel="alternate" type="text/plain" href="https://landingo.id/llms.txt" title="AI / LLM Summary" />

    <!-- Analytics & Pixel Preconnect -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />

    <!-- Non-Blocking Analytics, UTM Attribution, Ads Tracking & Reliable click_whatsapp Delegation -->
    <script is:inline>
      (function () {
        var loaded = false;
        var PIXEL_ID = '4334842353459488';
        window.dataLayer = window.dataLayer || [];
        if (typeof window.gtag !== 'function') {
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
        }

        // Persist UTM parameters across internal page transitions (/ -> /gallery -> /preview/*)
        var utmSource = '';
        var utmCampaign = '';
        try {
          var params = new URLSearchParams(window.location.search);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (key) {
            var val = params.get(key);
            if (val) sessionStorage.setItem('landingo_' + key, val);
          });
          utmSource = sessionStorage.getItem('landingo_utm_source') || '';
          utmCampaign = sessionStorage.getItem('landingo_utm_campaign') || '';
        } catch (_) {}

        function sendPixelBeacon(eventName, label) {
          var url =
            'https://www.facebook.com/tr?id=' +
            PIXEL_ID +
            '&ev=' +
            encodeURIComponent(eventName) +
            '&noscript=1' +
            (label ? '&cd[content_name]=' + encodeURIComponent(label) : '');
          if (navigator.sendBeacon) {
            navigator.sendBeacon(url);
          } else {
            var img = new Image();
            img.src = url;
          }
        }

        function loadTrackers() {
          if (loaded) return;
          loaded = true;

          // Google Analytics 4 (gtag.js)
          window.gtag('js', new Date());
          window.gtag('config', 'G-TYY3N6871E');
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-TYY3N6871E';
          document.head.appendChild(gaScript);

          // Meta Pixel (fbevents.js)
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = true;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = true;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', PIXEL_ID);
          window.fbq('track', 'PageView');
        }

        window.__landingoLoadTrackers = loadTrackers;

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || typeof target.closest !== 'function') return;
          var anchor = target.closest('a[href*="api.whatsapp.com"], a[href*="wa.me"]');
          if (!anchor) return;

          loadTrackers();

          var section = anchor.closest('section, header, footer, nav');
          var label =
            anchor.getAttribute('data-wa-location') ||
            (section && section.id) ||
            (anchor.classList.contains('mobile-cta') ? 'mobile-cta' : 'whatsapp_cta');
          var href = anchor.getAttribute('href') || '';

          window.gtag('event', 'click_whatsapp', {
            event_category: 'engagement',
            event_label: label,
            link_url: href,
            page_path: window.location.pathname,
            utm_source: utmSource || undefined,
            utm_campaign: utmCampaign || undefined,
            transport_type: 'beacon',
          });

          if (typeof window.fbq === 'function' && window.fbq.callMethod) {
            window.fbq('track', 'Contact', { content_name: label });
          } else {
            // Ensure instant mobile WA clicks are not lost before fbevents.js finishes downloading
            sendPixelBeacon('Contact', label);
          }
        });

        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (evt) {
          window.addEventListener(evt, loadTrackers, { once: true, passive: true });
        });

        if (document.readyState === 'complete') {
          setTimeout(loadTrackers, 300);
        } else {
          window.addEventListener('load', function () {
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(loadTrackers, { timeout: 800 });
            } else {
              setTimeout(loadTrackers, 300);
            }
          }, { once: true });
        }
      })();
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=4334842353459488&ev=PageView&noscript=1" />
    </noscript>
  </body>
</html>
