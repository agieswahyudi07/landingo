---
import '../assets/main.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Landingo - Landing Page Profesional untuk UMKM | Mulai dari Rp 1,5 Juta | SEO Optimized',
  description = 'Transformasi bisnis UMKM Anda dengan landing page yang mengkonversi visitor menjadi customer. Desain modern, loading cepat, SEO optimized, dan siap untuk iklan digital. Mulai dari Rp 1,5 Juta dengan diskon promo. Siap online dalam 2-5 hari kerja.',
  image = 'https://landingo.id/assets/images/seo.webp',
  type = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://landingo.id');
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="landing page profesional, website UMKM, landing page murah, landing page SEO optimized, jasa pembuatan landing page, landing page Indonesia, website untuk bisnis, landing page cepat, landing page mobile-first, landing page WhatsApp ready" />
    <meta name="author" content="Landingo" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="language" content="Indonesian" />
    <meta name="revisit-after" content="7 days" />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:site_name" content="Landingo" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/assets/images/landingo_logo2.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/webp" href="/assets/images/landingo_logo2.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL.toString()} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#2563EB" />
    <meta name="msapplication-TileColor" content="#2563EB" />
    
    <!-- Resource Hints for Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.whatsapp.com" />
    
    <!-- Preload Critical Resources -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" as="style" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
    
    <!-- Preload Logo Images -->
    <link rel="preload" as="image" href="/assets/images/landingo_logo2.webp" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href="/assets/images/landingo_logo.webp" fetchpriority="high" type="image/webp" />

    <!-- LLM Context & AI Agent Discovery -->
    <link rel="alternate" type="text/plain" href="https://landingo.id/llms.txt" title="AI / LLM Summary" />

    <!-- Structured Data JSON-LD (Multi-Entity Graph: Organization, ProfessionalService, OfferCatalog & FAQPage) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Organization", "ProfessionalService"],
          "@id": "https://landingo.id/#organization",
          "name": "Landingo",
          "url": "https://landingo.id",
          "logo": "https://landingo.id/assets/images/landingo_logo.webp",
          "image": "https://landingo.id/assets/images/seo.webp",
          "description": "Jasa pembuatan landing page terima beres dan profesional untuk bisnis jasa & UMKM di Indonesia. Mobile-first, loading cepat, SEO optimized, dan terintegrasi WhatsApp.",
          "priceRange": "IDR 1.500.000 - IDR 8.500.000",
          "currenciesAccepted": "IDR",
          "paymentAccepted": "Bank Transfer",
          "areaServed": {
            "@type": "Country",
            "name": "Indonesia"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+62-851-8307-7289",
            "contactType": "customer service",
            "availableLanguage": ["Indonesian", "English"]
          },
          "sameAs": [
            "https://www.instagram.com/landingo.id",
            "https://www.facebook.com/landingo.id",
            "https://www.linkedin.com/company/landingo.id"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Paket Pembuatan Landing Page Landingo",
            "itemListElement": [
              {
                "@type": "Offer",
                "name": "LANDINGO LITE",
                "description": "1 halaman landing page konversi tinggi untuk bisnis jasa, tombol WhatsApp langsung, domain & hosting 1 tahun, pengerjaan 2-3 hari kerja.",
                "price": "1500000",
                "priceCurrency": "IDR",
                "url": "https://landingo.id/#pricing",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Jasa Landing Page Paket LITE"
                }
              },
              {
                "@type": "Offer",
                "name": "LANDINGO PRO",
                "description": "Hingga 5 halaman website terpisah, Form Interaktif Dual-Action rekap otomatis ke Google Sheet klien & WhatsApp, Gratis Full Ads Tracking Setup (Meta Pixel + GTM + GA4), 1 akun email bisnis resmi.",
                "price": "4500000",
                "priceCurrency": "IDR",
                "url": "https://landingo.id/#pricing",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Jasa Landing Page Paket PRO (Paling Laris)"
                }
              },
              {
                "@type": "Offer",
                "name": "LANDINGO FUNNEL",
                "description": "Hingga 10 halaman website eksklusif, Akses Akun Landingo Central CMS Dashboard (kelola katalog & database leads mandiri), 3 akun email bisnis resmi, Gratis Full Ads Tracking.",
                "price": "8500000",
                "priceCurrency": "IDR",
                "url": "https://landingo.id/#pricing",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Jasa Landing Page Paket FUNNEL (Eksklusif CMS)"
                }
              }
            ]
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://landingo.id/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Berapa lama waktu pengerjaan landing page di Landingo?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Waktu pengerjaan berkisar antara 2–3 hari kerja untuk Paket LITE, 5–7 hari kerja untuk Paket PRO, dan 7–10 hari kerja untuk Paket FUNNEL setelah materi onboarding lengkap dan DP 50% diterima."
              }
            },
            {
              "@type": "Question",
              "name": "Apakah pembuatan landing page sudah termasuk materi penulisan promosi (copywriting)?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ya, seluruh paket di Landingo berkonsep 100% terima beres. Tim Landingo meriset dan menyusun copywriting persuasif yang menonjolkan solusi usaha Anda agar pengunjung terdorong untuk menghubungi WhatsApp."
              }
            },
            {
              "@type": "Question",
              "name": "Apa keunggulan Paket PRO dibanding Paket LITE?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Paket PRO mencakup hingga 5 halaman terpisah, Form Interaktif Dual-Action yang otomatis merekap data prospek ke Google Spreadsheet klien dan membuka WhatsApp admin, 1 akun email bisnis resmi (info@domain.id), serta GRATIS Full Setup Tracking Iklan (Meta Pixel + GTM + GA4) agar iklan tidak boncos."
              }
            },
            {
              "@type": "Question",
              "name": "Bagaimana sistem pembayaran di Landingo?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pembayaran dilakukan dalam 2 termin transparan: DP 50% di awal untuk mengunci slot antrean produksi, dan pelunasan 50% dibayarkan maksimal 3 hari kalender setelah website resmi online dan disetujui."
              }
            },
            {
              "@type": "Question",
              "name": "Bagaimana cara memantau performa pengunjung website?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Setiap klien mendapatkan 1 Link Live Dashboard Google Looker Studio yang terhubung ke Google Analytics 4 (GA4). Dashboard visual ini dapat dibuka dari smartphone kapan saja untuk memantau total pengunjung, jumlah klik tombol WhatsApp, dan kota asal visitor."
              }
            }
          ]
        }
      ]
    })} />

    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '4334842353459488');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=4334842353459488&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TYY3N6871E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TYY3N6871E');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

