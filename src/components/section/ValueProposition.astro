---
import LocalIcon from '../ui/LocalIcon.astro';
const features = [
  { icon: 'rocket', title: 'Launch lebih cepat', text: 'Landing page siap online dalam 2–5 hari kerja, tanpa proses teknis yang melelahkan.' },
  { icon: 'mobile', title: 'Nyaman di mobile', text: 'Setiap halaman dibangun agar jelas, cepat, dan mudah dipakai dari layar kecil.' },
  { icon: 'message', title: 'Siap menerima lead', text: 'Arahkan calon pelanggan langsung ke WhatsApp Anda tanpa form yang berbelit.' },
  { icon: 'shield', title: 'Setup teknis beres', text: 'Domain, hosting, SSL, dan fondasi SEO disiapkan dalam satu proses.' },
];
---
<section id="value-proposition" class="section section-soft">
  <div class="editorial-container">
    <div class="section-heading split-heading"><p class="eyebrow">Yang Anda dapatkan</p><h2>Hal-hal penting untuk mulai terlihat serius secara online.</h2><p>Kami fokus pada fondasi yang membuat bisnis jasa mudah dipahami dan mudah dihubungi.</p></div>
    <div class="feature-list">{features.map((item, index) => <article class="feature-item"><span class="feature-number">0{index + 1}</span><LocalIcon name={item.icon} /><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div>
  </div>
</section>
