---
import logoImage from '../../assets/landingo_logo.svg';
import { whatsappHref } from '../../lib/whatsapp';
import LocalIcon from '../ui/LocalIcon.astro';

const links = [
  { name: 'Cara Kerja', href: '/#process' },
  { name: 'Contoh Desain', href: '/#design-showcase' },
  { name: 'Paket', href: '/#pricing' },
  { name: 'Referensi Design', href: '/gallery' },
];
const whatsapp = whatsappHref('Halo! Saya ingin konsultasi tentang landing page profesional untuk bisnis saya.');
---
<footer class="site-footer">
  <div class="editorial-container footer-grid">
    <div><a href="/" class="brand"><img src={logoImage.src} alt="Landingo" width="1322" height="526" /></a><p>Partner digital untuk bisnis yang ingin tampil lebih jelas dan lebih meyakinkan secara online.</p></div>
    <div><h2>Navigasi</h2><ul>{links.map((link) => <li><a href={link.href}>{link.name}</a></li>)}</ul></div>
    <div><h2>Mulai dari sini</h2><p>Konsultasikan kebutuhan landing page Anda secara gratis.</p><a class="footer-contact" href={whatsapp} target="_blank" rel="noopener"><LocalIcon name="message" /> Konsultasi WhatsApp</a><a class="footer-email" href="mailto:official@landingo.id">official@landingo.id</a></div>
  </div>
  <div class="editorial-container footer-bottom">© {new Date().getFullYear()} Landingo. All rights reserved.</div>
</footer>
