---
import { Image } from 'astro:assets';
import { whatsappHref } from '../../lib/whatsapp';
import seoImage from '../../assets/seo.webp';
import LocalIcon from '../ui/LocalIcon.astro';

const consultationHref = whatsappHref('Halo! Saya ingin konsultasi tentang landing page untuk bisnis jasa saya.');
---

<main id="hero" class="hero-section">
  <div class="editorial-container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Landing page untuk bisnis jasa</p>
      <h1>Landing page yang membuat bisnis jasa terlihat siap dipilih.</h1>
      <p class="hero-intro">Landingo membantu bisnis Anda tampil lebih meyakinkan, lebih mudah ditemukan, dan siap menerima calon pelanggan lewat WhatsApp.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={consultationHref} target="_blank" rel="noopener">Konsultasi via WhatsApp <LocalIcon name="arrow-up-right" /></a>
        <a class="button button-secondary" href="#design-showcase">Lihat contoh desain</a>
      </div>
      <dl class="hero-proof" aria-label="Keunggulan layanan">
        <div><dt>2–5 hari</dt><dd>siap online</dd></div>
        <div><dt>Mobile-first</dt><dd>untuk calon pelanggan Anda</dd></div>
        <div><dt>WhatsApp</dt><dd>siap menerima lead</dd></div>
      </dl>
    </div>
    <div class="hero-work" aria-label="Contoh desain landing page Landingo">
      <div class="hero-work-label"><span></span> Pilihan desain untuk bisnis Anda</div>
      <div class="hero-preview-frame">
        <Image src={seoImage} alt="Ilustrasi optimasi SEO dan performa landing page" width={720} height={600} loading="eager" fetchpriority="high" />
      </div>
      <div class="hero-work-note">Dirancang untuk menjelaskan layanan dengan jelas—lalu mengarahkan calon pelanggan untuk menghubungi Anda.</div>
    </div>
  </div>
</main>
