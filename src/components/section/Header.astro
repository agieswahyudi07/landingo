---
import logoImage from '../../assets/landingo_logo.svg';
import { whatsappHref } from '../../lib/whatsapp';
import LocalIcon from '../ui/LocalIcon.astro';

const navLinks = [
  { href: '/#process', text: 'Cara Kerja' },
  { href: '/#design-showcase', text: 'Contoh Desain' },
  { href: '/#pricing', text: 'Paket' },
];
const consultationHref = whatsappHref('Halo! Saya ingin konsultasi tentang landing page profesional untuk bisnis saya.');
---

<header class="site-header">
  <div class="editorial-container header-inner">
    <a href="/" class="brand" aria-label="Landingo beranda"><img src={logoImage.src} alt="Landingo" width="1322" height="526" /></a>
    <button id="mobile-menu-button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu"><LocalIcon name="menu" /></button>
    <div id="mobile-menu" class="header-menu">
      <nav aria-label="Navigasi utama">{navLinks.map((link) => <a href={link.href}>{link.text}</a>)}</nav>
      <a class="header-cta" href={consultationHref} target="_blank" rel="noopener"><LocalIcon name="message" /> Konsultasi</a>
    </div>
  </div>
</header>

<script is:inline>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'Buka menu' : 'Tutup menu');
    menu.classList.toggle('is-open', !open);
  });
</script>
