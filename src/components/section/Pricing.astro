---
import LocalIcon from '../ui/LocalIcon.astro';
import { whatsappHref } from '../../lib/whatsapp';

const formatRupiah = (amount: number) =>
  amount.toLocaleString('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
  });

const commonFeatures = [
  'Website SSL aktif (aman & terenkripsi HTTPS)',
  'Penulisan konten website (copywriting terima beres)',
  'Akses Live Dashboard Statistik Looker Studio (GA4)',
  'Integrasi Google Maps & profil sosial media usaha',
  'Gratis Domain (.com/.id) & Cloud Hosting 1 tahun',
];

const packages = [
  {
    name: 'LANDINGO LITE',
    label: 'Untuk mulai online',
    realPrice: 3000000,
    discount: 50,
    price: 1500000,
    renewalPrice: 800000,
    description:
      'Untuk bisnis jasa yang butuh 1 halaman profil rapi agar calon pelanggan tidak ragu dan admin tidak lelah menjawab hal dasar.',
    features: [
      '1 halaman website konversi tinggi',
      'Copywriting persuasif terima beres',
      'Tombol WhatsApp langsung (Pre-filled chat)',
      'Live Dashboard Looker Studio (GA4) + Domain & hosting 1 thn',
      'Pengerjaan cepat 2–3 hari kerja & Garansi 15 hari',
    ],
    message:
      'Halo Landingo! Saya tertarik paket LANDINGO LITE.\nNama Bisnis:\nBidang Usaha:',
    popular: false,
  },
  {
    name: 'LANDINGO PRO',
    label: 'Pilihan utama (Paling Laris)',
    realPrice: 10000000,
    discount: 55,
    price: 4500000,
    renewalPrice: 1500000,
    description:
      'Untuk bisnis berkembang yang ingin tampil kredibel di hadapan klien premium dan siap beriklan terukur.',
    features: [
      'Semua fitur di paket LITE',
      'Hingga 5 halaman website terpisah',
      'Form interaktif rekap otomatis ke Google Sheet klien & WA',
      'Gratis Full Setup Tracking Iklan (Meta Pixel + GTM + GA4)',
      '1 akun email bisnis resmi (info@domainklien.id)',
      'Pengerjaan 5–7 hari kerja & Garansi support 30 hari',
    ],
    message:
      'Halo Landingo! Saya tertarik paket LANDINGO PRO (siap iklan & tracking).\nNama Bisnis:\nBidang Usaha:',
    popular: true,
  },
  {
    name: 'LANDINGO FUNNEL',
    label: 'Untuk skala lebih besar',
    realPrice: 15000000,
    discount: 45,
    price: 8500000,
    renewalPrice: 2500000,
    description:
      'Untuk bisnis dengan banyak portofolio/katalog dinamis yang butuh kontrol sistem mandiri tanpa pusing kode.',
    features: [
      'Semua fitur di paket PRO',
      'Hingga 10 halaman website eksklusif',
      'Akses Akun Landingo Central CMS Dashboard',
      'Kelola katalog, portofolio & jadwal dinamis mandiri',
      'Tabel database leads terpusat + auto-email notifikasi',
      '3 akun email bisnis resmi untuk divisi tim',
      'Gratis Full Setup Tracking Iklan (Custom Events)',
      'Pengerjaan 7–10 hari & Prioritas garansi support 60 hari',
    ],
    message:
      'Halo Landingo! Saya tertarik paket LANDINGO FUNNEL (dengan CMS).\nNama Bisnis:\nBidang Usaha:',
    popular: false,
  },
];
---

<section id="pricing" class="section pricing-section">
  <div class="editorial-container">
    <div class="section-heading pricing-heading">
      <p class="eyebrow">Paket &amp; harga</p>
      <h2>Pilih ruang yang tepat untuk bisnis Anda tumbuh.</h2>
      <p>
        Harga jelas, setup lengkap, dan Anda bisa memulai dari paket yang paling
        sesuai dengan kebutuhan saat ini.
      </p>
    </div>

    <div class="pricing-grid">
      {packages.map((item) => (
        <article class={`price-card${item.popular ? ' price-card-featured' : ''}`}>
          <p class="price-label">{item.label}</p>
          <h3>{item.name}</h3>
          <p class="price-description">{item.description}</p>
          <div class="price">
            <span class="price-old">{formatRupiah(item.realPrice)}</span>
            <strong>{formatRupiah(item.price)}</strong>
            <span class="discount">Hemat {item.discount}%</span>
          </div>
          <p class="renewal">Renewal {formatRupiah(item.renewalPrice)}/tahun</p>
          <ul>
            {item.features.map((feature) => (
              <li>
                <LocalIcon name="check" />
                {feature}
              </li>
            ))}
          </ul>
          <details>
            <summary>
              Lihat yang selalu termasuk <LocalIcon name="chevron-down" />
            </summary>
            <ul>
              {commonFeatures.map((feature) => (
                <li>
                  <LocalIcon name="check" />
                  {feature}
                </li>
              ))}
            </ul>
          </details>
          <a
            class={`button ${item.popular ? 'button-primary' : 'button-secondary'}`}
            href={whatsappHref(item.message)}
            data-wa-location={item.name.toLowerCase().replace(/\s+/g, '-')}
            target="_blank"
            rel="noopener"
          >
            Tanya paket ini <LocalIcon name="arrow-up-right" />
          </a>
        </article>
      ))}
    </div>

    <p class="pricing-note">
      <LocalIcon name="shield" /> Semua paket sudah termasuk setup lengkap tanpa biaya tersembunyi — DP 50% di awal, pelunasan 50% setelah website resmi live &amp; disetujui.
    </p>
  </div>
</section>
